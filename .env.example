# Copy this file to ".env" and fill in your real values.
# .env is gitignored — your keys never get committed.

# Supabase dashboard -> likho project -> Project Settings -> API Keys
# Use the "service_role" key (secret), NOT the "anon" key.
SUPABASE_SERVICE_ROLE_KEY=

# From @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Optional: only needed for cloud escalation when the local model struggles
FIREWORKS_API_KEY=
